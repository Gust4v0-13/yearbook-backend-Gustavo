datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

// Model Desenho — representa a tabela "Desenho" no banco
model Desenho {
  id        Int      @id @default(autoincrement())
  titulo    String
  imagemUrl String?
  artistaId Int
  artista   Artista  @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())
}

// Model Artista — representa a tabela "Artista" no banco
model Artista {
  id            Int        @id @default(autoincrement())
  nome          String
  email         String     @unique
  senhaHash     String
  cidade        String?
  bio           String?
  tecnica       String?
  fotoUrl       String?
  role          Role       @default(USER)
  criadoEm      DateTime   @default(now())
  desenhos      Desenho[]
}